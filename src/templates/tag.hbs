<!DOCTYPE html>
<html lang="en">
    {{!
        Arguments:
            tag: string
            description: string | undefined
            posts: {
                title: string
                date: string (ISO 8601)
                slug: string
            }[] (in reverse chronological order)
    }}
    <head>
        <meta charset="UTF-8" />
        <title>{{ tag }} - Lixquid</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/assets/favicon.png" />
        <meta name="title" content="{{ tag }} - Lixquid" />
        <meta name="description" content="{{ tag }} - Lixquid's blog" />
        <link rel="stylesheet" href="/assets/modern-normalize.css" />
        <link rel="stylesheet" href="/assets/index.css" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="RSS"
            href="/rss.xml"
        />
        <script src="/assets/index.ts" defer type="module"></script>
    </head>
    <body>
        <main>
            {{> header}}
            <header>
                <h1 class="coloured-tag">#{{ tag }}</h1>
                {{#if description}}
                <p class="header-subtitle">{{ description }}</p>
                {{/if}}
            </header>
            <ul>
                {{#each posts}}
                <li>
                    <a href="/{{ slug }}">{{ title }}</a>
                    <small class="text-subtle" title="{{ date }}"
                        >(<time class="relative-date" datetime="{{ date }}">{{
                            date
                        }}</time
                        >)</small
                    >
                </li>
                {{/each}}
            </ul>
        </main>
    </body>
</html>
