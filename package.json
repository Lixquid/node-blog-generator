{
    "name": "blog-generator",
    "version": "0.1.0",
    "author": {
        "name": "Lixquid",
        "url": "https://lixquid.com"
    },
    "scripts": {
        "start": "node src/index.ts build && node src/index.ts serve",
        "dev": "node src/index.ts watch",
        "build": "node src/index.ts build",
        "cli": "node src/cli.ts",
        "create": "node src/cli.ts create",
        "undraft": "node src/cli.ts undraft",
        "build:post": "node src/index.ts build",
        "build:production": "node src/index.ts build --production",
        "watch": "node src/index.ts watch",
        "serve": "node src/index.ts serve",
        "test": "globstar -- node --test \"src/**/*.test.ts\""
    },
    "license": "MIT",
    "private": true,
    "main": "index.js",
    "type": "module",
    "prettier": {
        "tabWidth": 4,
        "overrides": [
            {
                "files": "**/*.hbs",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "devDependencies": {
        "@types/node": "^24.19.0",
        "globstar": "^1.0.0"
    },
    "dependencies": {
        "front-matter": "^4.0.2",
        "handlebars": "^4.7.9",
        "highlight.js": "^11.12.0",
        "marked": "^18.0.14",
        "modern-normalize": "^3.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "zod": "^4.6.5"
    }
}
